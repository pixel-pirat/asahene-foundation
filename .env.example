# ── Vercel Blob (file uploads from admin) ───────────────────────────────────
# Create a Blob store in Vercel dashboard → Storage → Create → Blob
# Then copy the token from the store's details page
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get this from your Neon project dashboard → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ── Admin authentication ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.org
ADMIN_PASSWORD=your-secure-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=your-random-secret-at-least-32-chars
